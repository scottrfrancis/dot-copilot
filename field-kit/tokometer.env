# tokometer per-machine config — LOCKED-DOWN LAPTOP PROFILE (written by the field kit).
# Copilot in VS Code is the only harness; zero egress — no push, no sync.
# Requires the "GitHub Copilot Chat" output channel at Trace log level.

export TOKOMETER_HARNESSES="copilot_chat_log vscode_events copilot_vscode git_metrics"

# git metrics: where your repos live on this box and which author to count.
export TOKOMETER_GIT_ROOT="$HOME/workspace"
export TOKOMETER_GIT_AUTHOR="*"
export TOKOMETER_GIT_DEPTH="3"

# Windows Git Bash console defaults to cp1252; force UTF-8 so report glyphs render.
export PYTHONIOENCODING="utf-8"

# Overrides (defaults are correct for a standard VS Code install; uncomment to change):
# export VSCODE_LOGS_ROOT="$APPDATA/Code/logs"
# export COPILOT_CHAT_LOG_GLOB="$APPDATA/Code/logs/*/window*/exthost/output_logging_*/*GitHub Copilot Chat*.log"
# export COPILOT_SLOW_REQUEST_MS="30000"
# OTel cross-check (dormant — exporter not exposed on this profile as of 2026-07):
# export COPILOT_OTEL_FILE_EXPORTER_PATH="$USERPROFILE/workspace/otel-data"
